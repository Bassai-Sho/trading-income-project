# =============================================================================
# Trading Income Project — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values (or run ./setup.sh):
#   cp .env.example .env
#   nano .env
# =============================================================================

# ── 1. Broker & Paper Trading (Required for live engine & data download) ──────
# Free paper account at https://alpaca.markets (no funding required)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── 2. Macroeconomic & Sentiment Data (Free) ──────────────────────────────────
# St. Louis Fed FRED API: https://fred.stlouisfed.org/docs/api/api_key.html
# Used for VIXCLS, 2Y/10Y yield curves, HY OAS spreads, CPI
FRED_API_KEY=

# ── 3. Web & News Search API (Primary) ────────────────────────────────────────
# Brave Search API (optional): https://api.search.brave.com -- no free tier since Feb 2026;
# $5/month credit (~1,000 queries), card required, billed beyond that.
# If left empty, tool_runner automatically falls back to the ddgs multi-engine search (DDG_BACKEND)
BRAVE_SEARCH_API_KEY=

# ── 4. Hugging Face Authentication ────────────────────────────────────────────
# Free Read token: https://huggingface.co/settings/tokens
# Required to prevent rate-limiting during large model downloads (LFS)
HF_TOKEN=

# ── 5. Notifications (Optional) ───────────────────────────────────────────────
# Discord Webhook: Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 6. Database Paths (Do not change — standard project paths) ─────────────────
MARKET_DATA_DB=DATA/market_data.db
PAPER_ACCOUNT_DB=DATA/paper_account.db

# ── 7. Local OpenVINO GenAI Inference (Dual-Port Co-Residency) ─────────────────
LLM_BASE_URL=http://127.0.0.1:8000/v1
DAC_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=unused
LLM_PRESET=nuc-pair1

# Active OpenVINO Model Pair (Matches your ./setup.sh selection):
# Pair 1: Qwen3.8-27B (MTP built-in) + Phi-4-mini (Recommended)
LLM_MODEL_PRIMARY=qwen3.8:27b
LLM_MODEL_ADVERSARIAL=phi-4-mini:int4

# Pair 2: Qwen3.6-35B MoE + Mistral-Nemo-12B (High Speed)
# LLM_MODEL_PRIMARY=qwen3.6:35b-a3b
# LLM_MODEL_ADVERSARIAL=mistral-nemo:12b

# Pair 3: Qwen3.6-35B MoE + LFM2.5-8B (Liquid AI Non-Transformer)
# LLM_MODEL_PRIMARY=qwen3.6:35b-a3b
# LLM_MODEL_ADVERSARIAL=lfm2.5:8b

# ── 8. Open WebUI (Browser chat at http://localhost:8080) ─────────────────────
OPENAI_API_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=unused
WEBUI_AUTH=False
DATA_DIR=DATA/webui
