# Trading Income Project — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env

# ── Alpaca (required for historical data download + paper trading) ───────────
# Free paper account at https://alpaca.markets
# No funded account needed — paper trading is completely free
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # paper trading endpoint

# ── Database paths ───────────────────────────────────────────────────────────
MARKET_DATA_DB=DATA/market_data.db        # SQLite historical bar store
PAPER_ACCOUNT_DB=DATA/paper_account.db    # live paper trading + simulation

# ── Ollama (local LLM on NUC — session_analyser.py) ─────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Phase 1 model: fast MoE analysis (~18GB iGPU, 8-12 tok/s)
OLLAMA_MODEL_PHASE1=qwen3:30b-a3b
# Phase 2 model: D-A-C adversarial stress test (~17GB iGPU, 8-12 tok/s)
# qwen3.8:27b released Aug 2026 — better reasoning than qwen3:32b, smaller footprint
OLLAMA_MODEL_PHASE2=qwen3.8:27b
# Fast alternative: Gemma 4 MoE (4B active, ~16GB, 15-22 tok/s)
# OLLAMA_MODEL_PHASE2=gemma4:26b
# Phase 2 ADVERSARIAL — use a DIFFERENT architecture from Phase 2 analysis
# Mistral-NeMo-12B breaks intra-family sycophancy (Qwen critiquing Qwen)
OLLAMA_MODEL_ADVERSARIAL=mistral-nemo:12b
# Fallback / findings extraction (fast)
OLLAMA_MODEL_FALLBACK=qwen3:8b

# ── Discord notifications (optional) ────────────────────────────────────────
# Create a webhook in Discord: Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=

# ── Telegram notifications (optional) ───────────────────────────────────────
# @BotFather on Telegram to create a bot, get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Strategy configuration ───────────────────────────────────────────────────
DEFAULT_TICKER=SPY
DEFAULT_ORB_METHOD=15min       # 15min (VIX<=20 normal) or 30min (VIX>20)
DEFAULT_ACCOUNT_SIZE=10000     # paper account starting balance £
DEFAULT_RISK_PCT=0.01          # 1% max risk per trade

# ── Optional data sources ─────────────────────────────────────────────────────
# FRED (Federal Reserve Economic Data) — free API key at fred.stlouisfed.org
# Used by morning_brief.py for macro data: Fed Funds Rate, CPI, 10Y yield, etc.
# Not required — morning_brief falls back to yfinance if unset.
FRED_API_KEY=

# ── Cloud LLM fallback (optional) ────────────────────────────────────────────
# OpenRouter provides cloud-hosted Qwen3.8-27B, DeepSeek etc. as a fallback
# if the local Ollama model is unavailable. Free tier available.
# Used by session_analyser.py preset "openrouter-qwen38"
# See: openrouter.ai/keys
OPENROUTER_API_KEY=


# Brave Search API (web_search primary)
BRAVE_SEARCH_API_KEY=


# ── LLM inference — OpenVINO GenAI (./launch_models.sh --pair N) ────────────
# Pure-Python servers in .venv. /v1 endpoints. No Docker.
# Both models stay resident in 58GB VRAM pool simultaneously.

# Active pair — update to match your prepare_host.sh selection:
LLM_BASE_URL=http://127.0.0.1:8000/v1
DAC_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=unused

# Pair 1 — Thinking Quant (recommended): DeepSeek-R1-32B + Mistral-Nemo-12B
LLM_MODEL_PRIMARY=deepseek-r1:32b
LLM_MODEL_ADVERSARIAL=mistral-nemo:12b

# Pair 2 — High-Speed Agentic: Qwen3-30B-A3B + Mistral-Nemo-12B
# LLM_MODEL_PRIMARY=qwen3:30b-a3b
# LLM_MODEL_ADVERSARIAL=mistral-nemo:12b

# Pair 3 — Frontier Heavyweight: Qwen2.5-32B + Mistral-Small-24B
# LLM_MODEL_PRIMARY=qwen2.5:32b
# LLM_MODEL_ADVERSARIAL=mistral-small:24b

# ── LLM inference — Ollama fallback (./NUC_SETUP.sh) ─────────────────────────
# Uncomment if using IPEX-LLM Ollama instead of OpenVINO GenAI
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# DAC_BASE_URL=
# LLM_MODEL_PRIMARY=qwen3:30b-a3b
# LLM_MODEL_ADVERSARIAL=mistral-nemo:12b

# ── Open WebUI (chat interface at http://localhost:8080) ──────────────────────
# Pre-configured to point at Phase 1 OpenVINO model server
# Set WEBUI_AUTH=True to enable login for multi-user setups
OPENAI_API_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=unused
WEBUI_AUTH=False
DATA_DIR=DATA/webui
